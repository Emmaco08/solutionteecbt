 "intro": {
  "start": 0.0,
  "say": "Community is where students ask questions, share tips and help each other. Here's how to use it.",
  "vo": 0.6,
  "end": 6.0009999999999994
 },
 "outro": {
  "start": 44.843,
  "say": "Be kind, help others, and keep learning together. Next, learn how to take a full JAMB mock.",
  "end": 52.661
 },
 "chapters": [
  {
   "start": 6.001,
   "end": 9.086,
   "caption": "**Study** tab, then **Community**",
   "say": "Go to the Study tab, and tap Community."
  },
  {
   "start": 9.086,
   "end": 13.314,
   "caption": "Tap a **post** to open it",
   "say": "Scroll the feed, and tap any post to open it and see the replies."
  },
  {
   "start": 13.314,
   "end": 17.955,
   "caption": "Tap **Follow**",
   "say": "Like someone's posts? Tap Follow to see more of them in your Following tab."
  },
  {
   "start": 17.955,
   "end": 24.511,
   "caption": "Type **@** to mention someone",
   "say": "To answer, tap the reply box. Type the at sign and a name, then pick the person you want to mention."
  },
  {
   "start": 24.511,
   "end": 29.316,
   "caption": "Write it, then tap **Reply**",
   "say": "Write your reply, and tap Reply. It shows up in the thread straight away."
  },
  {
   "start": 29.316,
   "end": 33.219,
   "caption": "Tap **+** to make a post",
   "say": "To ask your own question, go back to the feed and tap the plus button."
  },
  {
   "start": 33.219,
   "end": 40.944,
   "caption": "Write it and **add a subject**",
   "say": "Type your question, and add a subject so the right people can find it."
  },
  {
   "start": 40.944,
   "end": 44.843,
   "caption": "Tap **Post**",
   "say": "Tap Post, and you're done. Your post is now live in the feed."
  }
 ],
