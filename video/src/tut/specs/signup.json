{
 "name": "signup",
 "title": "Create your account",
 "kicker": "Getting started",
 "duration": 47.76,
 "intro": {
  "start": 0.0,
  "say": "Here's how to create your SolutionTee account. It takes about a minute.",
  "vo": 0.6,
  "end": 4.9239999999999995
 },
 "outro": {
  "start": 41.662,
  "say": "That's it, you're in! Next, learn how to make your own custom exam.",
  "end": 47.457
 },
 "chapters": [
  {
   "start": 4.924,
   "end": 7.893,
   "caption": "Tap **Get started**",
   "say": "Open the app and tap Get started."
  },
  {
   "start": 7.893,
   "end": 12.575,
   "caption": "Type your **email** and a **password**",
   "say": "Type your email address, then choose a password with at least eight characters."
  },
  {
   "start": 12.575,
   "end": 16.878,
   "caption": "Tick the box, then tap **Create account**",
   "say": "Tick the box to agree to the terms, then tap Create account."
  },
  {
   "start": 16.878,
   "end": 21.72,
   "caption": "Type the **6-digit code** from your email",
   "say": "We send a six digit code to your email. Type it in, and your email is verified."
  },
  {
   "start": 21.72,
   "end": 28.08,
   "caption": "Your **name**, **state** and **year of birth**",
   "say": "Now tell us about you. Type your full name, then choose your state and the year you were born."
  },
  {
   "start": 28.08,
   "end": 30.694,
   "caption": "Tap **Continue**",
   "say": "When you're done, tap Continue."
  },
  {
   "start": 30.694,
   "end": 34.183,
   "caption": "Pick **your exams**",
   "say": "Pick every exam you're writing. You can choose more than one."
  },
  {
   "start": 34.183,
   "end": 38.655,
   "caption": "Choose your **3 JAMB subjects**",
   "say": "Choose your three JAMB subjects. Use of English is already included."
  },
  {
   "start": 38.655,
   "end": 41.662,
   "caption": "Tap **Finish setup**",
   "say": "Tap Finish setup, and you're ready to practise."
  }
 ],
