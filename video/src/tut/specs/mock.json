 "chapters": [
  {
   "start": 4.922,
   "end": 8.797,
   "caption": "**Test** tab, then **Start full exam**",
   "say": "Go to the Test tab, and tap Start full exam."
  },
  {
   "start": 8.797,
   "end": 15.144,
   "caption": "Check your subjects, then **Start**",
   "say": "Your four exam subjects are already set. Check them, then tap Start full exam."
  },
  {
   "start": 15.144,
   "end": 20.491,
   "caption": "Tap an **option**, then **Next**",
   "say": "The exam screen works like the real CBT. Tap an option to answer, then tap Next."
  },
  {
   "start": 20.491,
   "end": 24.091,
   "caption": "Tap the **flag** to come back later",
   "say": "Not sure? Tap the flag, and come back to it later."
  },
  {
   "start": 24.091,
   "end": 27.648,
   "caption": "Tap a **subject** to switch",
   "say": "Tap a subject at the top to switch subjects at any time."
  },
  {
   "start": 27.648,
   "end": 35.498,
   "caption": "Use the **calculator**",
   "say": "Need to calculate? Tap the calculator icon, work it out, then close it."
  },
  {
   "start": 35.498,
   "end": 40.487,
   "caption": "Tap the **grid** to jump to any question",
   "say": "Tap the grid icon to see every question. Tap any number to jump straight to it."
  },
  {
   "start": 40.487,
   "end": 45.884,
   "caption": "Answers save as you go. Tap **Submit**",
   "say": "Your answers save as you go, even if you close the app. When you've finished, tap Submit."
  },
  {
   "start": 45.884,
   "end": 49.171,
   "caption": "Check, then **Submit now**",
   "say": "Check your summary, then tap Submit now."
  },
  {
   "start": 49.171,
   "end": 53.167,
   "caption": "Your **score out of 400**",
   "say": "You get your score out of four hundred straight away, with a score for each subject."
  },
  {
   "start": 53.167,
   "end": 58.37,
   "caption": "**Review answers** and learn",
   "say": "Tap Review answers to see what you got wrong, and ask SolutionTee AI to explain it."
