<?xml version="1.0" encoding="utf-8"?>
<!-- App-icon shortcut (D-136, owner 20 Nov 2026): the real app logo, the same artwork as the launcher icon
     (mipmap ic_launcher_foreground, from brand/favicon.svg) on the navy circle. Kept in release builds by res/raw/keep.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@mipmap/ic_launcher_foreground" android:gravity="fill" android:antialias="true" android:filter="true" />
    </item>
</layer-list>
