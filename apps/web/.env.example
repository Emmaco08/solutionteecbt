# Copy to apps/web/.env.local (git-ignored). Never commit real values.

# Supabase (Project Settings → API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (or legacy anon) key: safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (or legacy service_role) key: SERVER ONLY. Used only to invite staff. Leave empty to disable invites.
SUPABASE_SECRET_KEY=

# Cloudflare R2 (images, D-045). SERVER ONLY. Leave empty until R2 is set up; uploads are disabled then.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_QUESTION_BUCKET=st-question-images
R2_PUBLIC_BUCKET=st-public
# Public CDN base for st-public, e.g. https://cdn.solutiontee.com
R2_PUBLIC_BASE_URL=
