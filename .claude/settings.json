{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "WebFetch",
      "WebSearch",
      "mcp__Supabase",
      "mcp__Vercel",
      "mcp__github",
      "mcp__claude-code-remote"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git push * --delete *)",
      "Bash(supabase db reset*)",
      "Bash(pnpm supabase db reset*)",
      "Bash(npx supabase db reset*)",
      "Bash(supabase projects delete*)",
      "Bash(supabase functions delete*)",
      "Bash(vercel remove*)",
      "Bash(npx vercel remove*)",
      "Bash(vercel rm*)",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__create_project",
      "mcp__Supabase__delete_feedback",
      "mcp__github__delete_file",
      "mcp__github__merge_pull_request",
      "mcp__github__create_repository",
      "mcp__Vercel__pause_project",
      "mcp__Vercel__get_project_deletion_link",
      "mcp__Vercel__revoke_kms_signing_key",
      "mcp__Vercel__request_rollback",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__replace_domain_dns_records",
      "mcp__Vercel__put_firewall_config",
      "mcp__claude-code-remote__archive_session",
      "mcp__claude-code-remote__delete_trigger"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__execute_sql|mcp__Supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.query // \"\"' | grep -qiE '\\b(drop[[:space:]]+(table|schema|database|type|function|view)|truncate)\\b|delete[[:space:]]+from' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"This SQL can delete data or tables (DROP / TRUNCATE / DELETE). Approve only if you expect it.\"}}' || true",
            "statusMessage": "Checking SQL for destructive statements"
          }
        ]
      }
    ]
  }
}
