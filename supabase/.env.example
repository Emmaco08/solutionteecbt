# Copy to supabase/.env (git-ignored). Used only on your laptop by `pnpm db:test` and admin scripts.
# Supabase → Connect → Session pooler. Replace [YOUR-PASSWORD] with the database password.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
